{
  "intro": {
    "hash": "6c1767334a88",
    "duration": 13.05,
    "segs": [
      {
        "t": "Hi. In this video you will set up your access to SAP BPC",
        "cue": "title",
        "start": 0,
        "end": 4.365
      },
      {
        "t": "in five simple steps.",
        "cue": null,
        "start": 4.876,
        "end": 6.42
      },
      {
        "t": "At the end, we only need one thing from you:",
        "cue": "ask",
        "start": 7.117,
        "end": 9.555
      },
      {
        "t": "a screenshot that shows you were able to log in.",
        "cue": "shot",
        "start": 9.996,
        "end": 13.05
      }
    ]
  },
  "roadmap": {
    "hash": "44e8b83eb3ed",
    "duration": 17.647,
    "segs": [
      {
        "t": "Here is the path.",
        "cue": null,
        "start": 0,
        "end": 0.975
      },
      {
        "t": "One: the BPC course in SuccessFactors.",
        "cue": "r1",
        "start": 1.567,
        "end": 4.319
      },
      {
        "t": "Two: the SAP access request.",
        "cue": "r2",
        "start": 4.818,
        "end": 7.198
      },
      {
        "t": "Three: install SAP Analysis for Office.",
        "cue": "r3",
        "start": 7.79,
        "end": 10.635
      },
      {
        "t": "Four: the connections file.",
        "cue": "r4",
        "start": 11.308,
        "end": 13.061
      },
      {
        "t": "And five: log on to BPC.",
        "cue": "r5",
        "start": 13.305,
        "end": 15.708
      },
      {
        "t": "Let's go step by step.",
        "cue": "go",
        "start": 16.033,
        "end": 17.647
      }
    ]
  },
  "course": {
    "hash": "187a18ef624b",
    "duration": 23.731,
    "segs": [
      {
        "t": "Step one: the course.",
        "cue": null,
        "start": 0,
        "end": 2.02
      },
      {
        "t": "Go to SuccessFactors and click View My Learning.",
        "cue": "quick",
        "start": 2.717,
        "end": 5.515
      },
      {
        "t": "Search for BPC HR Online Learning and open the course.",
        "cue": "search",
        "start": 6.118,
        "end": 9.613
      },
      {
        "t": "It has four modules and can take up to three hours.",
        "cue": "course",
        "start": 10.054,
        "end": 13.05
      },
      {
        "t": "Modules one and four end with a quiz you need to pass.",
        "cue": "quiz",
        "start": 13.747,
        "end": 17.021
      },
      {
        "t": "When you finish module four, take a screenshot of your certificate",
        "cue": "cert",
        "start": 17.531,
        "end": 21.014
      },
      {
        "t": "and send it to the HRSS team.",
        "cue": "send",
        "start": 21.131,
        "end": 23.731
      }
    ]
  },
  "check": {
    "hash": "3f88289e10d8",
    "duration": 24.706,
    "segs": [
      {
        "t": "Step two: SAP access.",
        "cue": null,
        "start": 0,
        "end": 2.659
      },
      {
        "t": "First, check whether you already have it.",
        "cue": null,
        "start": 3.355,
        "end": 5.584
      },
      {
        "t": "In the NEO portal, go to Support, Access Management, IDLookup.",
        "cue": "support",
        "start": 6.281,
        "end": 10.797
      },
      {
        "t": "Type your name exactly as it appears in Teams,",
        "cue": "lookup",
        "start": 11.238,
        "end": 13.92
      },
      {
        "t": "click Bulk Search, and then click your ID.",
        "cue": "bulk",
        "start": 14.199,
        "end": 16.811
      },
      {
        "t": "If you see bat-sapRoles-P52 with your market role,",
        "cue": "p52",
        "start": 17.415,
        "end": 21.153
      },
      {
        "t": "you already have access: skip to step three.",
        "cue": "skip",
        "start": 21.536,
        "end": 24.706
      }
    ]
  },
  "request": {
    "hash": "b8088efd69bd",
    "duration": 19.041,
    "segs": [
      {
        "t": "If you don't, open NEO.",
        "cue": "neo",
        "start": 0,
        "end": 1.776
      },
      {
        "t": "Under Quick Links, open Access Requests",
        "cue": "quick",
        "start": 2.392,
        "end": 4.667
      },
      {
        "t": "and then Access Request Creation.",
        "cue": "arc",
        "start": 4.888,
        "end": 6.757
      },
      {
        "t": "In Description, write your name, your role and why you need access.",
        "cue": "form",
        "start": 7.384,
        "end": 11.32
      },
      {
        "t": "Request Type: New Account. Request For: Self.",
        "cue": "fields",
        "start": 12.179,
        "end": 15.651
      },
      {
        "t": "Functional Area: Human Resources.",
        "cue": "area",
        "start": 16.498,
        "end": 19.041
      }
    ]
  },
  "sysrole": {
    "hash": "934746f2d6b7",
    "duration": 25.867,
    "segs": [
      {
        "t": "In the User Access tab, click Add and choose System.",
        "cue": "addsys",
        "start": 0,
        "end": 3.402
      },
      {
        "t": "Find P52 Client 100 and move it to Selected with the arrow.",
        "cue": "p52",
        "start": 4.087,
        "end": 8.603
      },
      {
        "t": "Click OK.",
        "cue": "ok",
        "start": 9.102,
        "end": 10.205
      },
      {
        "t": "Now Add again, and this time choose Role.",
        "cue": "addrole",
        "start": 10.704,
        "end": 13.816
      },
      {
        "t": "Copy the role for your market from this list.",
        "cue": "roles",
        "start": 14.245,
        "end": 16.463
      },
      {
        "t": "Paste it in Role / Profile Name and click Search.",
        "cue": "search",
        "start": 16.904,
        "end": 19.493
      },
      {
        "t": "Select the one that says P52 Client 100 and move it down with the arrow.",
        "cue": "avail",
        "start": 20.097,
        "end": 25.867
      }
    ]
  },
  "details": {
    "hash": "299b954e9f34",
    "duration": 22.152,
    "segs": [
      {
        "t": "In User Details, choose the company for your market",
        "cue": "details",
        "start": 0,
        "end": 2.752
      },
      {
        "t": "and type HR as the Function.",
        "cue": "function",
        "start": 2.902,
        "end": 4.818
      },
      {
        "t": "In User System Details, open the User Group picker.",
        "cue": "usersys",
        "start": 5.515,
        "end": 8.731
      },
      {
        "t": "Search for your country between asterisks, for example *Mexico*,",
        "cue": "group",
        "start": 9.172,
        "end": 14.687
      },
      {
        "t": "choose the HR group and click OK.",
        "cue": "hr",
        "start": 15.012,
        "end": 17.323
      },
      {
        "t": "Finally, click Submit.",
        "cue": "submit",
        "start": 17.926,
        "end": 19.459
      },
      {
        "t": "Your request goes out for approval.",
        "cue": "sent",
        "start": 19.9,
        "end": 22.152
      }
    ]
  },
  "install": {
    "hash": "6e2cdbe97526",
    "duration": 30.836,
    "segs": [
      {
        "t": "Step three: install SAP Analysis for Office.",
        "cue": null,
        "start": 0,
        "end": 3.785
      },
      {
        "t": "Open the Windows menu, type BAT Company Portal and open it.",
        "cue": "start",
        "start": 4.168,
        "end": 7.964
      },
      {
        "t": "If this window pops up, choose BAT Company Portal.",
        "cue": "popup",
        "start": 8.568,
        "end": 11.645
      },
      {
        "t": "In the portal search box, type Analysis and press Enter.",
        "cue": "portal",
        "start": 12.086,
        "end": 15.302
      },
      {
        "t": "Choose the 64 or 32-bit version: the same one as your Excel.",
        "cue": "results",
        "start": 15.906,
        "end": 20.596
      },
      {
        "t": "To check, in Excel go to File, Account, About Excel.",
        "cue": "about",
        "start": 21.107,
        "end": 25.229
      },
      {
        "t": "Install the app and restart your computer. Don't skip this step.",
        "cue": "restart",
        "start": 25.833,
        "end": 30.836
      }
    ]
  },
  "connections": {
    "hash": "eadb2605e5ae",
    "duration": 21.919,
    "segs": [
      {
        "t": "Step four: the connections file.",
        "cue": null,
        "start": 0,
        "end": 2.508
      },
      {
        "t": "Close every Excel window.",
        "cue": "close",
        "start": 2.949,
        "end": 4.667
      },
      {
        "t": "Download the Connections file from the Library Resources module on SharePoint.",
        "cue": "download",
        "start": 5.364,
        "end": 9.648
      },
      {
        "t": "Open File Explorer and paste this path into the address bar.",
        "cue": "path",
        "start": 10.344,
        "end": 14.222
      },
      {
        "t": "Replace OneID with your employee number.",
        "cue": "oneid",
        "start": 14.918,
        "end": 17.507
      },
      {
        "t": "Delete the existing Connections file and paste the new one.",
        "cue": "replace",
        "start": 18.018,
        "end": 21.919
      }
    ]
  },
  "launch": {
    "hash": "44058d815560",
    "duration": 15.79,
    "segs": [
      {
        "t": "Step five: log on.",
        "cue": null,
        "start": 0,
        "end": 1.811
      },
      {
        "t": "From the Windows menu, open Analysis for Microsoft Excel and wait for it to load.",
        "cue": "analysis",
        "start": 2.415,
        "end": 7.059
      },
      {
        "t": "Then open EPM add-in for Excel.",
        "cue": "epm",
        "start": 7.663,
        "end": 10.182
      },
      {
        "t": "Excel should now show the EPM, Analysis and Analysis Design tabs.",
        "cue": "ribbon",
        "start": 10.623,
        "end": 15.79
      }
    ]
  },
  "logon": {
    "hash": "3655fb20efaf",
    "duration": 16.208,
    "segs": [
      {
        "t": "Go to the EPM tab and click Log On.",
        "cue": "logon",
        "start": 0,
        "end": 2.148
      },
      {
        "t": "Click the three-dots button.",
        "cue": "dots",
        "start": 2.635,
        "end": 3.831
      },
      {
        "t": "Find P52 - BAT_HCT - HCT (SSO),",
        "cue": "manager",
        "start": 4.029,
        "end": 11.54
      },
      {
        "t": "set it as default and click OK.",
        "cue": "default",
        "start": 11.9,
        "end": 13.781
      },
      {
        "t": "And now: Log On.",
        "cue": "final",
        "start": 14.199,
        "end": 16.208
      }
    ]
  },
  "evidence": {
    "hash": "cd14a186083f",
    "duration": 12.399,
    "segs": [
      {
        "t": "Done! You're in BPC.",
        "cue": "done",
        "start": 0,
        "end": 2.426
      },
      {
        "t": "Take a screenshot that shows the connection.",
        "cue": "snip",
        "start": 2.752,
        "end": 5.004
      },
      {
        "t": "Windows + Shift + S makes it quick.",
        "cue": "keys",
        "start": 5.515,
        "end": 8.464
      },
      {
        "t": "Send it to HRSS to confirm your access.",
        "cue": "send",
        "start": 9.067,
        "end": 12.399
      }
    ]
  },
  "outro": {
    "hash": "2ba0657a65b6",
    "duration": 7.245,
    "segs": [
      {
        "t": "Course, access, Analysis, connections and Log On.",
        "cue": "recap",
        "start": 0,
        "end": 3.216
      },
      {
        "t": "If anything goes wrong along the way, reach out. Thank you!",
        "cue": "thanks",
        "start": 3.657,
        "end": 7.245
      }
    ]
  }
}